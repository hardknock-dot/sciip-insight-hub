# Local Ollama is the default Copilot provider.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# For a cloud OpenAI-compatible provider instead, set AI_PROVIDER to "groq" or "openai"
# and provide the matching API key and optional base URL/model.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6

SCIIP_DB_PATH=../data/sciip.db
SCIIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCIIP_COPILOT_MAX_TURNS=8
